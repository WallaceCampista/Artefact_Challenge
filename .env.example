# Copy to .env and adjust. Every value below is the default, so the file is optional
# when LM Studio runs locally with the recommended models.

# ---- LLM provider (any OpenAI-compatible server) ----
# LM Studio (default): start the server on port 1234 and load the models below.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen2.5-7b-instruct
# 0 = reproducible answers; 0.2 scored the same on the evals.
LLM_TEMPERATURE=0
LLM_TIMEOUT=120
# longest answer, in tokens (the longest real answers use about 300)
LLM_MAX_TOKENS=800

# OpenAI instead of a local model:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ---- Policy retrieval ----
# Embedding model served by the same provider. Leave empty to use BM25 only.
# Qwen3-Embedding is multilingual; nomic-embed-text (English-centric) scored worse than
# BM25 alone on the Portuguese questions in evals/policy_retrieval.json.
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b

# ---- Agent ----
# Maximum tool calls the model can chain to answer one message.
MAX_TOOL_STEPS=6
# Previous user/assistant exchanges sent back to the model.
HISTORY_TURNS=6

# ---- Store context ----
STORE_TIMEZONE=America/Campo_Grande
# Freeze "now" for reproducible demos and evals (ISO 8601). Empty = real clock.
# REFERENCE_DATETIME=2026-11-03T10:30:00

# ---- Paths ----
# DATA_DIR=data
# VAR_DIR=var
